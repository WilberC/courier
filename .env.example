APP_ENV=development
APP_PORT=8000

# Local Python run (outside Docker)
DATABASE_URL=sqlite:///./courier.db
REDIS_URL=redis://localhost:6379/0

# Docker compose will override these to:
# DATABASE_URL=sqlite:////app/data/courier.db
# REDIS_URL=redis://redis:6379/0

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USER_IDS=123456789
# Optional: defaults to TELEGRAM_ALLOWED_USER_IDS
TELEGRAM_ADMIN_USER_IDS=123456789

API_SHARED_SECRET=replace_me
SENTRY_DSN=

# API safety limits
EVENT_RATE_LIMIT_PER_MINUTE=60
EVENT_MAX_PAYLOAD_BYTES=32768
